# Build outputs — regenerated by gradle; the CI workflow uploads the APK as an
# artifact instead of committing it.
.gradle/
build/
app/build/
local.properties

# The embedded gateway binary is produced by the Go cross-compile step. It is
# tracked on purpose so a checkout builds without a Go toolchain, but it must be
# refreshed by `make gateway` whenever the Go sources change.
# (kept: app/src/main/jniLibs/arm64-v8a/libwb2hub.so)

# OS noise
.DS_Store
Thumbs.db

# Runtime state an operator may have dropped in by hand
auths/
data/
usage/
*.log
